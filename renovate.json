{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		"config:best-practices",
		"github>JamieTanna-Mend-testing/staged-releases-branch-per-env//.github/renovate-dev.json#dev",
		"github>JamieTanna-Mend-testing/staged-releases-branch-per-env//.github/renovate-staging.json#staging"
	],
	"baseBranchPatterns": ["dev", "staging", "prod"],
	"customManagers": [
		{
			"customType": "jsonata",
			"description": "Keep the `nginx` `allowedVersions` packageRule in sync with the regular NGINX Docker image",
			"fileFormat": "json",
			"managerFilePatterns": [".github/renovate-*.json"],
			"matchStrings": [
				"packageRules[\"nginx\" in matchDepNames].{ \"depName\": matchDepNames[0], \"packageName\": matchDepNames[0], \"currentValue\": $substringAfter(allowedVersions, \"<=\") }"
			],
			"datasourceTemplate": "docker",
			"versioningTemplate": "docker"
		}
	],
	"packageRules": [
		{
			"description": "Don't try to digest-pin the `nginx` version tracked in the `allowedVersions` presets, as it's a version constraint, not a real image reference",
			"matchFileNames": [".github/renovate-*.json"],
			"matchDatasources": ["docker"],
			"pinDigests": false
		},
		{
			"description": "`dev` branch: raise PRs immediately, no gating",
			"matchBaseBranches": ["dev"],
			"commitMessageSuffix": " (`dev` branch)"
		},
		{
			"description": "`staging` branch: hold behind the Dependency Dashboard until manually promoted",
			"matchBaseBranches": ["staging"],
			"commitMessageSuffix": " (`staging` branch)",
			"dependencyDashboardApproval": true
		},
		{
			"description": "`prod` branch: hold behind the Dependency Dashboard until manually promoted",
			"matchBaseBranches": ["prod"],
			"commitMessageSuffix": " (`prod` branch)",
			"dependencyDashboardApproval": true
		}
	]
}
